# SMTP configuration for real email OTP delivery
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Resend API configuration (Recommended for production/cloud hosting)
RESEND_API_KEY=re_your_api_key

# Grok AI Chat Assistant (xAI or BluesMinds fallback)
XAI_API_KEY=xai-your-xai-api-key
XAI_BASE_URL=https://api.x.ai/v1

BLUESMINDS_API_KEY=sk-your-bluesminds-api-key
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1

